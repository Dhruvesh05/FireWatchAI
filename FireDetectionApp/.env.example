# ForestGuard AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Telegram Bot credentials (from @BotFather)
BOT_TOKEN=
CHAT_ID=

# Alert cooldown in seconds (default 60)
TELEGRAM_ALERT_COOLDOWN=60

# Flask session secret key — use a long random string in production
FLASK_SECRET_KEY=change-this-to-a-long-random-secret
